# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# OBRIGATÓRIO em produção (Supabase > Project Settings > API > service_role). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API (use um domínio estável, não túnel temporário)
EVOLUTION_API_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=

# Segredo do webhook do WhatsApp (gere um valor aleatório longo, ex.: openssl rand -hex 32)
WEBHOOK_SECRET=

# Google Gemini API Key
GEMINI_API_KEY=

# Cobrança (Asaas) — https://www.asaas.com
ASAAS_API_KEY=
# Use "sandbox" para testes; omita (ou "production") em produção
ASAAS_ENV=
# Token que o Asaas envia no header asaas-access-token no webhook /api/webhook/asaas
ASAAS_WEBHOOK_TOKEN=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Observabilidade & Alertas (opcionais)
# DSN do Sentry para envio automático de exceções
SENTRY_DSN=
# Webhook externo (Slack, Discord, n8n etc.) para alertas de erro/queda
ALERT_WEBHOOK_URL=
# Resend API Key opcional para avisar clientes por e-mail caso o WhatsApp desconecte
RESEND_API_KEY=
ALERT_FROM_EMAIL=ERBots <alertas@erbots.com.br>
